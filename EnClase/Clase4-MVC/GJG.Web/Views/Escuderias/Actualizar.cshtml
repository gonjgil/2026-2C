@model GJG.Entidades.Escuderia
@{
}

<h1>Actualizar Escuderia</h1>
<form action="@Url.Action("Actualizar", "Escuderias")" method="post">
    <input type="hidden" name="Id" value="@Model.Id" />
    <div class="form-group">
        <label for="Nombre">Nombre</label>
        <input type="text" class="form-control" id="Nombre" name="Nombre" value="@Model.Nombre" />
    </div>
    <div action="form-group">
        <label for="Motor">Motor</label>
        <input type="text" class="form-control" id="Motor" name="Motor" value="@Model.Motor" />
    </div>
    <div class="form-group">
        <label for="Puntos">Puntos</label>
        <input type="text" class="form-control" id="Puntos" name="Puntos" value="@Model.Puntos" />
    </div>
    <button type="submit" class="btn btn-primary">Actualizar</button>
    <a href="/Escuderias" class="btn btn-secondary">Cancelar</a>
</form>