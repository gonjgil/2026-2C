@model List<GJG.Entidades.Escuderia>
@{

}

<h1>Escuderias</h1>
Listado de Escuderias del Campeonato de F1 en 2026
<table class="table">
    <thead>
        <tr>
            <td></td>
            <td>Puntos</td>
            <td>Motor</td>
            <td>Fundada</td>
            <td>País</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var escuderia in Model)
        {
            <tr>
                <td>@escuderia.ImagenUrl<a asp-action="Actualizar" asp-route-id="@escuderia.Id">@escuderia.Nombre</a></td>
                <td>@escuderia.Puntos</td>
                <td>@escuderia.Motor</td>
                <td>@escuderia.Fundacion</td>
                <td>@escuderia.Pais</td>
            </tr>
        }
    </tbody>
</table>