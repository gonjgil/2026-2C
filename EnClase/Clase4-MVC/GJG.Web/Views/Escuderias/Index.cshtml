@model List<GJG.Entidades.Escuderia>
@{

}

<h1>Escuderias</h1>
Listado de Escuderias del Campeonato de F1 en 2026
<table class="table">
    <thead>
        <tr>
            <td></td>
            <td>Puntos</td>
            <td>Motor</td>
            <td>Fundada</td>
            <td>País</td>
            <td>Acciones</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var escuderia in Model)
        {
            <tr>
                <td>@escuderia.ImagenUrl @escuderia.Nombre</td>
                <td>@escuderia.Puntos</td>
                <td>@escuderia.Motor</td>
                <td>@escuderia.Fundacion</td>
                <td>@escuderia.Pais</td>
                <td>
                    <a asp-action="Actualizar" asp-route-id="@escuderia.Id"
                       class="btn btn-primary">Actualizar</a>
                    <a asp-action="Eliminar" asp-route-id="@escuderia.Id"
                       class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>