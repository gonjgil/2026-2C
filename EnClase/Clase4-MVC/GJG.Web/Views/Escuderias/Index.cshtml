@model List<GJG.Entidades.Escuderia>
@using Paises
@{
}

<h1>Escuderias</h1>
Listado de Escuderias del Campeonato de F1 en 2026
<table class="table">
    <thead>
        <tr>
            <td></td>
            <td>Puntos</td>
            <td>Motor</td>
            <td>Fundada</td>
            <td>País</td>
            <td>Acciones</td>
        </tr>
    </thead>
    <tbody>
        @foreach (var escuderia in Model)
        {
            string codigoIso = Banderas.ObtenerCodigoIso(escuderia.Pais);
            <tr>
                <td><img src="@escuderia.ImagenUrl" width="40" height="40" alt="@escuderia.Nombre"/>
                    @escuderia.Nombre</td>
                <td>@escuderia.Puntos</td>
                <td>@escuderia.Motor</td>
                <td>@escuderia.Fundacion</td>
                <td>
                    <div style='display: flex; align-items: center; gap: 8px;'>
                        @if (!string.IsNullOrEmpty(codigoIso))
                        {
                            <img src='https://flagcdn.com/w20/@(codigoIso).png'
                                 srcset='https://flagcdn.com/w40/@(codigoIso).png 2x' width='20'
                                 alt='Bandera de @escuderia.Pais' />
                        }
                        <span> @escuderia.Pais</span>
                    </div>
                </td>
                <td>
                    <a asp-action="Actualizar" asp-route-id="@escuderia.Id" class="btn btn-primary">Actualizar</a>
                    <a asp-action="Eliminar" asp-route-id="@escuderia.Id" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>